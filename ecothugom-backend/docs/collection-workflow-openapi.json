{
  "openapi": "3.1.0",
  "info": {
    "title": "EcoThuGom Collection Workflow API",
    "version": "1.0.0",
    "description": "Contract: ../../README.md#doc-ecothugom-backend-docs-collection-workflow-md. One dealer; session cookie + CSRF. No payment integration."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/api/auth/csrf": {
      "get": {
        "operationId": "getCsrf",
        "summary": "Get CSRF token; retain session cookie",
        "description": "",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Csrf"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Sign in; rotate session ID and invalidate old CSRF",
        "description": "",
        "security": [
          {
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unsupported fields",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid CSRF token or forbidden role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit; Retry-After contains seconds",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until another attempt may be made."
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "currentUser",
        "summary": "Get current user",
        "description": "Required role: any authenticated. Authorization uses the current server-side account, not client-supplied identity.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Invalidate session; fetch new CSRF before next login",
        "description": "",
        "security": [
          {
            "csrfToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session invalidated"
          },
          "403": {
            "description": "Missing/invalid CSRF token or forbidden role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/collector/orders/{id}/start-trip": {
      "post": {
        "operationId": "collectorEN_ROUTE",
        "summary": "COLLECTOR chuyển đơn sang EN_ROUTE",
        "description": "Only assigned ACTIVE collector; exact state sequence and order version. Atomic audit and version increment.",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/StorageFailure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirm"
              },
              "example": {
                "version": 2
              }
            }
          }
        }
      }
    },
    "/api/collector/orders/{id}/arrive": {
      "post": {
        "operationId": "collectorARRIVED",
        "summary": "COLLECTOR chuyển đơn sang ARRIVED",
        "description": "Only assigned ACTIVE collector; exact state sequence and order version. Atomic audit and version increment.",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/StorageFailure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirm"
              },
              "example": {
                "version": 3
              }
            }
          }
        }
      }
    },
    "/api/collector/orders/{id}/weighings": {
      "get": {
        "operationId": "listOrderWeighings",
        "summary": "Nhân viên xem lịch sử cân",
        "description": "",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeighResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/StorageFailure"
          }
        }
      },
      "post": {
        "operationId": "recordOrderWeighings",
        "summary": "Ghi cân thực tế hoặc phiếu điều chỉnh",
        "description": "ARRIVED only. gross > tare >= 0, KG with at most 3 decimals. Correction must reference latest weighing and include reason. Append-only; atomic batch and orderVersion increment.",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeighResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/StorageFailure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WeighRequest"
              },
              "example": {
                "version": 4,
                "items": [
                  {
                    "itemId": 1,
                    "grossWeight": 5.25,
                    "tareWeight": 0.25
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/collector/orders/{id}/quotes": {
      "post": {
        "operationId": "sendActualQuote",
        "summary": "Gửi báo giá theo cân và giá đã duyệt",
        "description": "ARRIVED or replace expired current SENT. All items weighed and currently priced. Server snapshots latest weighing/current APPROVED price; rounds each line HALF_UP to VND, sums lines. Valid 24h. Order -> AWAITING_SELLER_APPROVAL; no client price overrides.",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/StorageFailure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Version"
              },
              "example": {
                "version": 5
              }
            }
          }
        }
      },
      "get": {
        "operationId": "collectorListQuotes",
        "summary": "Xem tối đa 100 báo giá mới nhất",
        "description": "Descending versionNumber. CUSTOMER own order, COLLECTOR assigned order, ADMIN any. Empty array if no quotes. orderVersion is current order version; version is quote row version; versionNumber is quote sequence.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "$ref": "#/components/schemas/Quote"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/StorageFailure"
          }
        }
      }
    },
    "/api/customer/orders/{id}/quotes": {
      "get": {
        "operationId": "customerListQuotes",
        "summary": "Xem tối đa 100 báo giá mới nhất",
        "description": "Descending versionNumber. CUSTOMER own order, COLLECTOR assigned order, ADMIN any. Empty array if no quotes. orderVersion is current order version; version is quote row version; versionNumber is quote sequence.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "$ref": "#/components/schemas/Quote"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/StorageFailure"
          }
        }
      }
    },
    "/api/admin/orders/{id}/quotes": {
      "get": {
        "operationId": "adminListQuotes",
        "summary": "Xem tối đa 100 báo giá mới nhất",
        "description": "Descending versionNumber. CUSTOMER own order, COLLECTOR assigned order, ADMIN any. Empty array if no quotes. orderVersion is current order version; version is quote row version; versionNumber is quote sequence.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "$ref": "#/components/schemas/Quote"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/StorageFailure"
          }
        }
      }
    },
    "/api/customer/orders/{id}/quotes/{quoteId}/accept": {
      "post": {
        "operationId": "customerAcceptQuote",
        "summary": "Khách đồng ý báo giá",
        "description": "Only owner. Current SENT and order AWAITING_SELLER_APPROVAL; exact order and quote versions, now strictly before validUntil. Order -> AWAITING_PAYMENT. Atomic quote response, order version and audit. Repeated/stale/expired requests ->409. Payment not included.",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          },
          {
            "$ref": "#/components/parameters/QuoteId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/StorageFailure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Review"
              },
              "example": {
                "version": 6,
                "quoteVersion": 0,
                "responseNote": "Đã kiểm tra kết quả cân"
              }
            }
          }
        }
      }
    },
    "/api/customer/orders/{id}/quotes/{quoteId}/reject": {
      "post": {
        "operationId": "customerRejectQuote",
        "summary": "Khách từ chối báo giá",
        "description": "Only owner. Current SENT and order AWAITING_SELLER_APPROVAL; exact order and quote versions, now strictly before validUntil. Order -> ARRIVED. Atomic quote response, order version and audit. Repeated/stale/expired requests ->409. Payment not included.",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          },
          {
            "$ref": "#/components/parameters/QuoteId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/StorageFailure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Review"
              },
              "example": {
                "version": 6,
                "quoteVersion": 0,
                "responseNote": "Đã kiểm tra kết quả cân"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "fullName",
          "phone",
          "role",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "COLLECTOR",
              "ADMIN"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "LOCKED"
            ]
          }
        }
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fullName",
          "phone",
          "password"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "pattern": "^0[35789][0-9]{8}$"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 254,
            "description": "Optional; blank becomes null, trimmed and normalized to lowercase."
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 64,
            "writeOnly": true,
            "description": "Maximum 72 UTF-8 bytes."
          }
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "password"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254,
            "description": "Phone or email; trimmed, email is case insensitive."
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 64,
            "writeOnly": true,
            "description": "Maximum 72 UTF-8 bytes."
          }
        }
      },
      "Csrf": {
        "type": "object",
        "required": [
          "headerName",
          "token"
        ],
        "properties": {
          "headerName": {
            "type": "string",
            "const": "X-CSRF-TOKEN"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "StatusChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "LOCKED"
            ]
          }
        }
      },
      "OrderSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "pickupStart": {
            "type": "string",
            "description": "UTC date-time without zone suffix, stored as SQL DATETIME2."
          },
          "pickupEnd": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      },
      "UserPage": {
        "type": "object",
        "required": [
          "data",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "OrderPage": {
        "type": "object",
        "required": [
          "data",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderSummary"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "code",
          "status",
          "collectorId",
          "sourceAddressId",
          "contactName",
          "contactPhone",
          "address",
          "sellerNote",
