      "Confirm": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483646
          },
          "reason": {
            "type": [
