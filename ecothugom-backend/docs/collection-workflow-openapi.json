          "code": {
            "type": "string",
            "maxLength": 40
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "ASSIGNED",
              "EN_ROUTE",
              "ARRIVED",
              "AWAITING_SELLER_APPROVAL",
              "AWAITING_PAYMENT",
              "COMPLETED",
              "CANCELLED",
              "DISPUTED"
            ]
          },
          "collectorId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "sourceAddressId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Null for inline-address bookings"
          },
          "contactName": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "sellerNote": {
            "type": [
              "string",
              "null"
            ]
          },
          "pickupStart": {
            "type": "string",
            "format": "date-time"
          },
          "pickupEnd": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "const": "VND"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "estimatedTotal": {
            "type": [
              "number",
              "null"
            ],
            "description": "Sum of rounded item estimates; null if any quantity/price is unknown. Not the final purchase amount."
          },
          "pickupLocation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PickupLocation"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "required": [
          "itemId",
          "materialId",
          "materialName",
          "grade",
          "unit",
          "estimatedQty",
          "estimatedPriceRuleId",
          "estimatedUnitPrice",
          "estimatedLineTotal",
          "priceStatus",
          "note"
        ],
        "properties": {
          "itemId": {
            "type": "integer",
            "format": "int64"
          },
          "materialId": {
            "type": "integer",
            "format": "int32"
          },
          "materialName": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "estimatedQty": {
            "type": [
              "number",
              "null"
            ]
          },
          "estimatedPriceRuleId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "estimatedUnitPrice": {
            "type": [
              "number",
              "null"
            ],
            "description": "Saved snapshot; later price changes do not overwrite it"
          },
          "estimatedLineTotal": {
            "type": [
              "number",
              "null"
            ],
            "description": "ROUND(quantity * saved price, 0), VND"
          },
          "priceStatus": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "CONTACT_FOR_QUOTE"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "photoUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000,
            "description": "Private /api/evidence/... URL for API uploads; GET requires order permission."
          }
        }
