            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "correctionOf": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "correctionReason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "photoUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000,
            "description": "Private /api/evidence/... URL for API uploads; GET requires order permission."
          }
        },
        "required": [
          "id",
          "itemId",
          "grossWeight",
          "tareWeight",
          "netWeight",
          "createdBy",
          "createdAt",
          "correctionOf",
          "correctionReason"
        ]
      },
      "WeighResult": {
        "type": "object",
