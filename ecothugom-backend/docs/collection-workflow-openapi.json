      "Version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483646
          }
        },
        "required": [
          "version"
        ]
      },
      "Review": {
        "type": "object",
