{
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Windows local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "fullName",
          "phone",
          "role",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "COLLECTOR",
              "ADMIN"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "LOCKED"
            ]
          }
        }
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fullName",
          "phone",
          "password"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "pattern": "^0[35789][0-9]{8}$"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 254,
            "description": "Optional; blank becomes null, trimmed and normalized to lowercase."
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 64,
            "writeOnly": true,
            "description": "Maximum 72 UTF-8 bytes."
          }
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "password"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254,
            "description": "Phone or email; trimmed, email is case insensitive."
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 64,
            "writeOnly": true,
            "description": "Maximum 72 UTF-8 bytes."
          }
        }
      },
      "Csrf": {
        "type": "object",
        "required": [
          "headerName",
          "token"
        ],
        "properties": {
          "headerName": {
            "type": "string",
            "const": "X-CSRF-TOKEN"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "StatusChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "LOCKED"
            ]
          }
        }
      },
      "OrderSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "pickupStart": {
            "type": "string",
            "description": "UTC date-time without zone suffix, stored as SQL DATETIME2."
          },
          "pickupEnd": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      },
      "UserPage": {
        "type": "object",
        "required": [
          "data",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "OrderPage": {
        "type": "object",
        "required": [
          "data",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderSummary"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "CategoryInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        },
        "required": [
          "name"
        ]
      },
      "CategoryStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "isActive"
        ]
      },
      "AdminCategory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "isActive"
        ]
      },
      "MaterialInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1
          },
          "grade": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "enum": [
              "KG"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "excludedItems": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000,
            "format": "uri",
            "description": "HTTP/HTTPS URL with host, no credentials; stored only, never fetched by backend."
          }
        },
        "required": [
          "categoryId",
          "name",
          "grade",
          "unit"
        ]
      },
      "MaterialStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ]
      },
      "AdminMaterial": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "categoryId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1
          },
          "grade": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "enum": [
              "KG"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "excludedItems": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000,
            "format": "uri",
            "description": "HTTP/HTTPS URL with host, no credentials; stored only, never fetched by backend."
          },
          "categoryName": {
            "type": "string",
            "maxLength": 100
          },
          "categoryActive": {
            "type": "boolean"
          },
          "accepted": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "categoryId",
          "name",
          "grade",
          "unit",
          "description",
          "excludedItems",
          "imageUrl",
          "categoryName",
          "categoryActive",
          "accepted",
          "available"
        ]
      },
      "CategoryPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminCategory"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        },
        "required": [
          "data",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "MaterialPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminMaterial"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        },
        "required": [
          "data",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      }
    },
    "parameters": {
      "CatalogId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        }
      }
    }
  },
  "info": {
    "title": "EcoThuGom Admin Catalog API",
    "version": "1.0.0",
    "description": "Contract: ../../README.md#doc-ecothugom-backend-docs-admin-catalog-md. ADMIN manages categories/materials; public catalog remains read-only. PUT replaces information; PATCH /status changes visibility/acceptance. No hard deletes or price management. Session/CSRF required."
  },
  "paths": {
    "/api/auth/csrf": {
      "get": {
        "operationId": "getCsrf",
        "summary": "Get CSRF token; retain session cookie",
        "description": "",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Csrf"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Sign in; rotate session ID and invalidate old CSRF",
        "description": "",
        "security": [
          {
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unsupported fields",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid CSRF token or forbidden role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit; Retry-After contains seconds",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until another attempt may be made."
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "currentUser",
        "summary": "Get current user",
        "description": "Required role: any authenticated. Authorization uses the current server-side account, not client-supplied identity.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Invalidate session; fetch new CSRF before next login",
        "description": "",
        "security": [
          {
            "csrfToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session invalidated"
          },
          "403": {
            "description": "Missing/invalid CSRF token or forbidden role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/material-categories": {
      "get": {
        "operationId": "adminListCategory",
        "summary": "List including hidden/stopped records; id ASC",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "in": "query",
            "name": "isActive",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body/query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "ADMIN/CSRF required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Category/material not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate name/variant or conflicting constraint",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Persistence failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "adminCreateCategory",
        "summary": "Create with active/accepted=true",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCategory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body/query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "ADMIN/CSRF required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Category/material not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate name/variant or conflicting constraint",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Persistence failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryInput"
              },
              "example": {
                "name": "Giấy",
                "description": "Các loại giấy thu mua"
              }
            }
          }
        }
      }
    },
    "/api/admin/material-categories/{id}": {
      "get": {
        "operationId": "adminGetCategory",
        "summary": "Get including hidden/stopped",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CatalogId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCategory"
